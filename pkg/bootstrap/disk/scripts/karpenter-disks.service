[Unit]
Description=Karpenter data disk preparation
Documentation=https://github.com/oxidecomputer/karpenter-provider-oxide

# Avoid a dependency cycle with local-fs.target.
DefaultDependencies=no
Wants=systemd-udevd.service
After=systemd-udevd.service
Before=local-fs.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/lib/karpenter

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/var/lib/karpenter/disk-setup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=local-fs.target
